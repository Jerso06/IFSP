<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Aluno</title>
</head>
<body>
    <h1>Editar Aluno</h1>
    
    <!-- Formulário que envia os dados alterados via POST para a rota /editar/:id -->
    <form action="/editar/<%= aluno.id %>" method="POST">
        <div>
            <label for="nome">Nome:</label>
            <input type="text" id="nome" name="nome" value="<%= aluno.nome %>" required>
        </div>
        <br>
        <div>
            <label for="idade">Idade:</label>
            <input type="number" id="idade" name="idade" value="<%= aluno.idade %>" required>
        </div>
        <br>
        <button type="submit">Salvar Alterações</button>
    </form>
</body>
</html>